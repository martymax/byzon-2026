{
  "name": "@byzon/test-support",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./viewports": "./src/viewports.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "pretest": "pnpm --filter @byzon/domain build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@byzon/domain": "workspace:*",
    "zod": "catalog:"
  }
}
