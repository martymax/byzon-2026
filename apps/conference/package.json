{
  "name": "@byzon/conference",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "node scripts/mock-worker.mjs clean && node scripts/check-production-mock-boundary.mjs source && next build && node scripts/offline-shell-manifest.mjs && node scripts/check-production-mock-boundary.mjs build",
    "check:production-mocks": "node scripts/check-production-mock-boundary.mjs source && node scripts/check-production-mock-boundary.mjs build",
    "dev": "pnpm --filter @byzon/domain build && pnpm --filter @byzon/test-support build && node scripts/mock-worker.mjs prepare && next dev",
    "lint": "eslint .",
    "mocks:clean": "node scripts/mock-worker.mjs clean",
    "mocks:prepare": "node scripts/mock-worker.mjs prepare",
    "pretest": "pnpm --filter @byzon/database build && pnpm --filter @byzon/domain build && pnpm --filter @byzon/test-support build",
    "pretest:components": "pnpm --filter @byzon/domain build && pnpm --filter @byzon/test-support build",
    "start": "node .next/standalone/apps/conference/server.js",
    "test": "vitest run",
    "test:components": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@byzon/config": "workspace:*",
    "@byzon/database": "workspace:*",
    "@byzon/domain": "workspace:*",
    "@byzon/ui": "workspace:*",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@byzon/test-support": "workspace:*",
    "axe-core": "4.12.1",
    "msw": "2.15.0"
  }
}
