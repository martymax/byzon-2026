{
  "name": "byzon-2026",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm build:web && pnpm build:worker",
    "build:static": "python3 static-site/build.py",
    "build:web": "pnpm --filter @byzon/database build && pnpm --filter @byzon/domain build && pnpm --filter @byzon/conference build",
    "build:worker": "pnpm --filter @byzon/worker build",
    "dev": "pnpm --parallel --filter @byzon/conference --filter @byzon/worker dev",
    "dev:mock": "BYZON_FRONTEND_PREVIEW=enabled NEXT_PUBLIC_BYZON_API_MOCKS=enabled pnpm --filter @byzon/conference dev",
    "preview:static": "python3 -m http.server --directory static-site/public 8000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:a11y": "PLAYWRIGHT_ALLOW_LIVE_START=1 playwright test tests/e2e/accessibility.spec.ts",
    "test:components": "pnpm --filter @byzon/conference test:components",
    "test:static": "python3 tests/static_site_smoke.py",
    "test:e2e": "playwright test",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:static"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  }
}
