# Bezpečné, nesekretní hodnoty pro lokální skeleton etapy 1.
NODE_ENV=development
APP_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:8000
LOG_LEVEL=info
RELEASE_SHA=local
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/byzon
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379
REDIS_FAMILY=0
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=2000
BETTER_AUTH_SECRET=local-only-better-auth-secret-change-me
RATE_LIMIT_SUBJECT_SECRET=local-only-rate-limit-subject-secret-change-me

# Citlivé a integrační proměnné se aktivují v příslušných etapách.
# SIMPLESHOP_API_EMAIL=
# SIMPLESHOP_API_KEY=
# SIMPLESHOP_API_BASE_URL= # pouze automatické testy; staging/production odmítá
# TICKET_CODE_PEPPER_ACTIVE=
# CHECKIN_DEVICE_ID= # UUID zařízení vytvořeného příkazem db:provision-checkin-device
