{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:monorepos"],
  "rangeStrategy": "pin",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchManagers": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
